#!/usr/bin/env bash

WALL_DIR="$HOME/Pictures/walls"

# Ensure directory exists
mkdir -p "$WALL_DIR"

# Launch fzf with Kitty's native graphics protocol for high-res previews
WALL=$(fzf --walker-root "$WALL_DIR" \
  --preview 'kitten icat --clear --transfer-mode=memory --stdin=no --place="${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}@0x0" {}' \
  --preview-window=right:65%)

# Update symlink and apply with feh if a file was selected
if [ -n "$WALL" ]; then
    ln -sf "$WALL" "$WALL_DIR/wall.jpg"
    feh --bg-fill "$WALL_DIR/wall.jpg"
fi
