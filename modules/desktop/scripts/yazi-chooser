#!/usr/bin/env bash

multiple="$1"
directory="$2"
path="$3"
out="$4"

# Fallback check if arguments didn't pass through
if [ -z "$out" ]; then
    echo "Error: Output path argument missing from portal." >&2
    exit 1
fi

# Determine starting directory
if [ -d "$path" ]; then
    start_dir="$path"
elif [ -f "$path" ]; then
    start_dir="$(dirname "$path")"
else
    start_dir="$HOME"
fi

# Run Yazi
if [ "$directory" = "1" ]; then
    yazi "$start_dir" --chooser-file="$out" --cwd-file="$out"
else
    yazi "$start_dir" --chooser-file="$out"
fi

# Check if a file was selected
if [ -s "$out" ]; then
    exit 0
else
    exit 1
fi
