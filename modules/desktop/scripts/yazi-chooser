#!/usr/bin/env bash

multiple="$1"
directory="$2"
path="$3"
out="$4"

# Handle starting path
if [ -d "$path" ]; then
    start_dir="$path"
elif [ -f "$path" ]; then
    start_dir="$(dirname "$path")"
else
    start_dir="$HOME"
fi

# Ensure output file is empty or created
> "$out"

if [ "$directory" = "1" ]; then
    yazi "$start_dir" --chooser-file="$out" --cwd-file="$out"
else
    yazi "$start_dir" --chooser-file="$out"
fi

# If the user made a selection, exit with 0 (success)
if [ -s "$out" ]; then
    exit 0
else
    # Non-zero exit tells the portal the user cancelled
    exit 1
fi
