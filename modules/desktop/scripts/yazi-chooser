#!/usr/bin/env bash

# Correct positional mapping for xdg-desktop-portal-termfilechooser
multiple="$1"
directory="$2"
save="$3"
path="$4"
out="$5"

# Fallback: if $5 is empty, try $4
if [ -z "$out" ]; then
    out="$4"
fi

# Set starting directory
if [ -d "$path" ]; then
    start_dir="$path"
elif [ -f "$path" ]; then
    start_dir="$(dirname "$path")"
else
    start_dir="$HOME"
fi

# Make sure output file exists
touch "$out"

# Execute yazi
if [ "$directory" = "1" ]; then
    yazi "$start_dir" --chooser-file="$out" --cwd-file="$out"
else
    yazi "$start_dir" --chooser-file="$out"
fi

# Exit with success if user selected a file
if [ -s "$out" ]; then
    exit 0
else
    exit 1
fi
